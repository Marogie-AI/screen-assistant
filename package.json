{
  "name": "screen-assistant",
  "version": "0.1.0",
  "description": "A privacy-conscious Firefox screen assistant powered by the locally authenticated Codex CLI.",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @screen-assistant/firefox-extension dev",
    "docs:check": "node scripts/check-markdown.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm docs:check && pnpm typecheck && pnpm test && pnpm build",
    "install:host": "pnpm --filter @screen-assistant/native-host install:host",
    "smoke:host": "node scripts/smoke-installed-host.mjs",
    "spike": "pnpm --filter @screen-assistant/native-host spike"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
